{
  "name": "@super-go/app",
  "version": "0.0.1",
  "private": true,
  "description": "Electron 壳：main(adapters) / preload / renderer(UI)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build-app": "electron-vite build && electron-builder --mac --win",
    "build:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@super-go/core": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@nut-tree/node-mac-permissions": "2.2.1",
    "@nut-tree/nut-js": "4.2.0",
    "koffi": "3.1.6",
    "onnxruntime-node": "1.29.0"
  }
}
